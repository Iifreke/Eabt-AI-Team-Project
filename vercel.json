{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/chat/index.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "buildCommand": "npm run build && node -e \"import('fs').then(fs => fs.cpSync('admin/dist', 'deploy', { recursive: true }))\"",
  "outputDirectory": "deploy"
}
